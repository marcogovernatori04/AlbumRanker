@page "/albums/{id:int}"
@using AlbumRanker.Web.DTOs.Albums
@using AlbumRanker.Web.Services
@inject AlbumApiService AlbumApiService

<h3>Detalle del álbum</h3>

@if (album == null)
{
    <p>Cargando...</p>
}
else
{
    <div>
        <h2>@album.Titulo</h2>
        <p><strong>Artista:</strong> @album.Artista</p>
        <p><strong>Año:</strong> @album.Anio</p>
        <p><strong>Promedio:</strong> @album.Promedio</p>

        <h4>Canciones</h4>

        @if (!album.Canciones.Any())
        {
            <p>Este álbum todavía no tiene canciones.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Duración</th>
                        <th>Puntuación</th>
                        <th>Nota</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cancion in album.Canciones)
                    {
                        <tr>
                            <td>@cancion.NumeroPista</td>
                            <td>@cancion.Titulo</td>
                            <td>@FormatearDuracion(cancion.DuracionSegundos)</td>
                            <td>@cancion.Puntuacion</td>
                            <td>@cancion.Nota</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private AlbumDetalleDTO? album;

    protected override async Task OnInitializedAsync()
    {
        album = await AlbumApiService.GetById(Id);
    }

    private string FormatearDuracion(int segundos)
    {
        var minutos = segundos / 60;
        var restoSegundos = segundos % 60;

        return $"{minutos}:{restoSegundos:D2}";
    }
}